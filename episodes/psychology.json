{
  "version": 1,
  "title": "Your Brain Isn't Lazy\u2014Your Goals Might Be the Problem",
  "brief": "An original, research-informed five-minute story about Milo, who mistakes borrowed ambitions for personal failure. Ada helps him question a wall of impossible goals, choose one meaningful project and build a specific first step. Warm, tactile 2.5D visual metaphors: a goal wall, a backpack of expectations, a rope tied to a mountain, notifications, a tiny staircase and a forgiving progress calendar. Empathetic, provocative, never diagnostic; distinguish poor goal fit from time, health and material constraints. End with one imperfect page, not a miraculous life transformation.",
  "niche": "Psychology & Human Behavior",
  "requested_minutes": 5.0,
  "seed": 412,
  "provenance": "reviewed-plan",
  "factual_status": "source-grounded",
  "sources": [
    {
      "url": "https://selfdeterminationtheory.org/SDT/documents/1999_SheldonElliot.pdf",
      "claim": "Sheldon & Elliot (1999), DOI 10.1037/0022-3514.76.3.482: self-concordant goals were associated with sustained effort and attainment. This does not diagnose laziness or guarantee success. The characters and their outcomes are fictional."
    },
    {
      "url": "https://prospectivepsych.org/sites/default/files/pictures/Gollwitzer_Implementation-intentions-1999.pdf",
      "claim": "Gollwitzer (1999), DOI 10.1037/0003-066X.54.7.493: review of implementation intentions linking anticipated situations to goal-directed responses. The tea-and-writing example is an original fictional illustration, not a tested treatment."
    }
  ],
